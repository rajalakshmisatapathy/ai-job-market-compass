# Adzuna job listings API credentials: https://developer.adzuna.com/
# Optional: both must be set to enable Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble issues one API key per regional domain. Either set JOOBLE_COUNTRY
# with JOOBLE_API_KEY, or add country-specific keys with ISO suffixes such as
# JOOBLE_API_KEY_GB and JOOBLE_API_KEY_DE. Add other country keys as needed.
JOOBLE_API_KEY=
JOOBLE_COUNTRY=
JOOBLE_API_KEY_DE=
JOOBLE_API_KEY_GB=
JOOBLE_API_KEY_FR=
JOOBLE_API_KEY_NL=


# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000
